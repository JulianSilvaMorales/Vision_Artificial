# Entornos virtuales de Python
venv/
env/

# Cache de Python
__pycache__/
*.pyc

# Variables de entorno / configuracion sensible
.env

# Checkpoints de Jupyter
.ipynb_checkpoints/

# Dependencias de Node (frontend)
node_modules/

# Modelos entrenados que NO se quieran versionar directamente
# (si se decide versionarlos con Git LFS en vez de ignorarlos,
# quitar o ajustar estas lineas y agregar la extension al .gitattributes)
models/*.pt
models/*.h5

# Excepciones: pesos pequenos que si se versionan (con Git LFS)
!models/best_disc_detector.pt
!models/preetiquetado_semilla_v2.pt

# Dataset de 35.007 imagenes descomprimido y su zip (no se versionan; ver data/processed/README.md)
data/processed/DeepSpine_Dataset_35k.zip
data/processed/train/
data/processed/val/
data/processed/test/


# Pesos y artefactos de entrenamiento (se publican en GitHub Releases)
models/*.joblib
models/*.npz

# Entorno virtual que crean webapp/iniciar_mvp.bat y webapp/iniciar_mvp.sh
.venv-mvp*/
